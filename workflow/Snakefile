# Quality control, assembly, annotation and antimicrobial resistance (AMR)
# gene detection for bacterial isolates.
#
#   FastQC -> SPAdes -> QUAST -> Prokka -> Abricate -> summary tables
#
# Samples with reads go through every step. Samples with a ready assembly
# (column `assembly` in the sample sheet) skip FastQC and SPAdes.
#
# Run from the project folder:  pixi run run-snakemake
# (or: pixi run -e pipeline snakemake --cores 4)
# All tools come from the Pixi environment `pipeline` (pixi.lock).

import csv


configfile: "config/config.yaml"


OUT = config["outdir"]

with open(config["samples"]) as fh:
    SAMPLES = {row["sample"]: row for row in csv.DictReader(fh, delimiter="\t")}

READ_SAMPLES = [s for s, row in SAMPLES.items() if row["fastq_1"]]
ASSEMBLED_SAMPLES = [s for s, row in SAMPLES.items() if row["assembly"]]
DATABASES = config["abricate"]["databases"]


wildcard_constraints:
    sample="|".join(SAMPLES),
    read="1|2",
    db="|".join(DATABASES),


def assembly(wc):
    """The assembly of a sample: the given one, or the SPAdes scaffolds."""
    if SAMPLES[wc.sample]["assembly"]:
        return f"data/processed/assemblies/{wc.sample}.fasta"
    return f"{OUT}/spades/{wc.sample}/scaffolds.fasta"


rule all:
    default_target: True
    input:
        expand(
            f"{OUT}/fastqc/{{sample}}_R{{read}}_fastqc.html",
            sample=READ_SAMPLES,
            read=["1", "2"],
        ),
        expand(f"{OUT}/quast/{{sample}}/report.html", sample=SAMPLES),
        expand(f"{OUT}/prokka/{{sample}}/{{sample}}.gff", sample=SAMPLES),
        f"{OUT}/tables/assembly_stats.tsv",
        f"{OUT}/tables/read_stats.tsv",
        f"{OUT}/tables/annotation_stats.tsv",
        f"{OUT}/tables/amr_hits.tsv",
        expand(f"{OUT}/tables/abricate_summary_{{db}}.tsv", db=DATABASES),
        f"{OUT}/tables/software_versions.tsv",
        f"{OUT}/tables/abricate_databases.tsv",


rule fastqc:
    input:
        lambda wc: SAMPLES[wc.sample][f"fastq_{wc.read}"],
    output:
        html=f"{OUT}/fastqc/{{sample}}_R{{read}}_fastqc.html",
        zip=f"{OUT}/fastqc/{{sample}}_R{{read}}_fastqc.zip",
    log:
        f"{OUT}/logs/fastqc/{{sample}}_R{{read}}.log",
    params:
        tmp=f"{OUT}/fastqc/tmp_{{sample}}_R{{read}}",
    shell:
        # FastQC names its output after the input file; rename to the sample
        """
        mkdir -p {params.tmp}
        fastqc --quiet --outdir {params.tmp} {input} >{log} 2>&1
        mv {params.tmp}/*_fastqc.html {output.html}
        mv {params.tmp}/*_fastqc.zip {output.zip}
        rmdir {params.tmp}
        """


rule decompress_assembly:
    input:
        lambda wc: SAMPLES[wc.sample]["assembly"],
    output:
        "data/processed/assemblies/{sample}.fasta",
    shell:
        "gzip -dc {input} > {output}"


rule spades:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["fastq_1"],
        r2=lambda wc: SAMPLES[wc.sample]["fastq_2"],
    output:
        scaffolds=f"{OUT}/spades/{{sample}}/scaffolds.fasta",
    log:
        f"{OUT}/logs/spades/{{sample}}.log",
    threads: config["spades"]["threads"]
    resources:
        mem_mb=config["spades"]["memory_gb"] * 1024,
    params:
        outdir=f"{OUT}/spades/{{sample}}",
        memory=config["spades"]["memory_gb"],
        extra=config["spades"]["extra"],
    shell:
        """
        spades.py {params.extra} -1 {input.r1} -2 {input.r2} -o {params.outdir} \
            -t {threads} -m {params.memory} >{log} 2>&1
        """


rule quast:
    input:
        assembly,
    output:
        html=f"{OUT}/quast/{{sample}}/report.html",
        tsv=f"{OUT}/quast/{{sample}}/transposed_report.tsv",
    log:
        f"{OUT}/logs/quast/{{sample}}.log",
    threads: config["quast"]["threads"]
    params:
        outdir=f"{OUT}/quast/{{sample}}",
        reference=(
            f"-r {config['quast']['reference']}"
            if config["quast"]["reference"]
            else ""
        ),
        min_contig=config["quast"]["min_contig"],
    shell:
        """
        quast.py {input} -o {params.outdir} {params.reference} \
            --min-contig {params.min_contig} --threads {threads} \
            --labels {wildcards.sample} >{log} 2>&1
        """


rule prokka:
    input:
        assembly,
    output:
        gff=f"{OUT}/prokka/{{sample}}/{{sample}}.gff",
        txt=f"{OUT}/prokka/{{sample}}/{{sample}}.txt",
    log:
        f"{OUT}/logs/prokka/{{sample}}.log",
    threads: config["prokka"]["threads"]
    params:
        outdir=f"{OUT}/prokka/{{sample}}",
        kingdom=config["prokka"]["kingdom"],
        genus=config["prokka"]["genus"],
        extra=config["prokka"]["extra"],
    shell:
        """
        prokka --outdir {params.outdir} --prefix {wildcards.sample} --force \
            --kingdom {params.kingdom} --genus {params.genus} {params.extra} \
            --cpus {threads} {input} >{log} 2>&1
        """


rule abricate:
    input:
        assembly,
    output:
        f"{OUT}/abricate/{{sample}}/{{db}}.tsv",
    log:
        f"{OUT}/logs/abricate/{{sample}}_{{db}}.log",
    params:
        minid=config["abricate"]["min_identity"],
        mincov=config["abricate"]["min_coverage"],
    shell:
        """
        abricate --nopath --db {wildcards.db} --minid {params.minid} \
            --mincov {params.mincov} {input} >{output} 2>{log}
        """


rule abricate_summary:
    input:
        expand(f"{OUT}/abricate/{{sample}}/{{{{db}}}}.tsv", sample=SAMPLES),
    output:
        f"{OUT}/tables/abricate_summary_{{db}}.tsv",
    shell:
        "abricate --summary {input} > {output}"


rule summarise:
    input:
        quast=expand(f"{OUT}/quast/{{sample}}/transposed_report.tsv", sample=SAMPLES),
        prokka=expand(f"{OUT}/prokka/{{sample}}/{{sample}}.txt", sample=SAMPLES),
        fastqc=expand(
            f"{OUT}/fastqc/{{sample}}_R{{read}}_fastqc.zip",
            sample=READ_SAMPLES,
            read=["1", "2"],
        ),
        abricate=expand(
            f"{OUT}/abricate/{{sample}}/{{db}}.tsv", sample=SAMPLES, db=DATABASES
        ),
    output:
        assembly=f"{OUT}/tables/assembly_stats.tsv",
        reads=f"{OUT}/tables/read_stats.tsv",
        annotation=f"{OUT}/tables/annotation_stats.tsv",
        amr=f"{OUT}/tables/amr_hits.tsv",
    params:
        samples=config["samples"],
    shell:
        """
        python scripts/summarise.py --samples {params.samples} \
            --quast {input.quast} --prokka {input.prokka} \
            --fastqc {input.fastqc} --abricate {input.abricate} \
            --out-assembly {output.assembly} --out-reads {output.reads} \
            --out-annotation {output.annotation} --out-amr {output.amr}
        """


rule software_versions:
    output:
        versions=f"{OUT}/tables/software_versions.tsv",
        databases=f"{OUT}/tables/abricate_databases.tsv",
    shell:
        """
        printf 'tool\\tversion\\n' >{output.versions}
        printf 'snakemake\\t%s\\n' "$(snakemake --version)" >>{output.versions}
        printf 'fastqc\\t%s\\n' "$(fastqc --version | sed 's/FastQC v//')" >>{output.versions}
        printf 'spades\\t%s\\n' "$(spades.py --version 2>/dev/null | sed 's/SPAdes genome assembler v//')" >>{output.versions}
        printf 'quast\\t%s\\n' "$(quast.py --version 2>/dev/null | tail -1 | sed 's/QUAST v//')" >>{output.versions}
        printf 'prokka\\t%s\\n' "$(prokka --version 2>&1 | sed 's/prokka //')" >>{output.versions}
        printf 'abricate\\t%s\\n' "$(abricate --version | sed 's/abricate //')" >>{output.versions}
        abricate --list >{output.databases}
        """
